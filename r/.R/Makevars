# ===== Toolchain (Apple) =====
CC=/usr/bin/clang
CXX=/usr/bin/clang++
CXX11=/usr/bin/clang++
CXX14=/usr/bin/clang++
CXX17=/usr/bin/clang++

F77=/opt/homebrew/bin/gfortran
FC=/opt/homebrew/bin/gfortran

# ===== Optimizaciones =====
CFLAGS   += -O3 -fPIC
CXXFLAGS += -O3 -std=gnu++17 -stdlib=libc++
LDFLAGS  += -stdlib=libc++
