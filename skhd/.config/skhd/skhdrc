# swap ventana actual con la adyacente en la dirección
ctrl + alt + cmd - left  : yabai -m window --swap west
ctrl + alt + cmd - right : yabai -m window --swap east
ctrl + alt + cmd - up    : yabai -m window --swap north
ctrl + alt + cmd - down  : yabai -m window --swap south

# Ctrl + Option + Left → enfocar ventana a la izquierda
ctrl + alt - left  : yabai -m window --focus west

# Ctrl + Option + Right → enfocar ventana a la derecha
ctrl + alt - right : yabai -m window --focus east

# Ctrl + Option + Up → enfocar ventana arriba
ctrl + alt - up    : yabai -m window --focus north

# Ctrl + Option + Down → enfocar ventana abajo
ctrl + alt - down  : yabai -m window --focus south

# crecer/encoger ventana en el árbol BSP
ctrl + alt - h : yabai -m window --resize left:-40:0
ctrl + alt - l : yabai -m window --resize right:40:0
ctrl + alt - j : yabai -m window --resize bottom:0:40
ctrl + alt - k : yabai -m window --resize top:0:-40

